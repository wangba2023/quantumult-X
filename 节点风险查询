  }
})();

// API请求封装
async function fetchAPI(url) {
  try {
    const response = await $task.fetch({
      url: url,
      opts: { policy: $environment.params },
      timeout: 4000
    });
    return response.body;
  } catch (error) {
    console.log(`API请求失败: ${url}`);
    return null;
  }
}

// 解析地理数据
function parseGeoData(rawData) {
  try {
    const data = JSON.parse(rawData);
    return {
      ip: data.ip || "N/A",
      isp: data.isp || "N/A",
      country_code: data.country_code ? 
        `${data.country_code} ⟦${COUNTRY_FLAGS.get(data.country_code.toUpperCase()) || "🇺🇳"}⟧` : "N/A",
      city: data.city || "N/A"
    };
  } catch (e) {
    throw new Error("地理数据解析失败");
  }
}

// 生成地理信息显示
function generateGeoDisplay(geoData) {
  return DISPLAY_FIELDS.map(({ key, label }) => 
    `<b>${label}</b> : ${geoData[key]}</br>`
  ).join("") + HTML_TEMPLATES.SEPARATOR;
}

// 生成欺诈信息显示
function generateFraudDisplay(rawData) {
  try {
    const extractValue = (key) => {
      const regex = new RegExp(`"${key}":\\s*"([^"]+)"`);
      const match = rawData.match(regex);
      return match ? match[1] : "N/A";
    };

    return `
      <b>欺诈指数</b> : ${extractValue("score")}</br>
      <b>风险等级</b> : ${RISK_TRANSLATIONS[extractValue("risk").toLowerCase()] || "未知风险"}
    `;
  } catch (e) {
    console.log("欺诈信息解析失败");
    return "";
  }
}

// 统一错误处理
function handleError(message) {
  const errorDisplay = `
    ${HTML_TEMPLATES.WRAPPER("font-weight: bold;")}
      </br></br>🛑 ${message || "查询超时"}
    </p>
  `;
  
  $done({
    "title": "🔎 IP.SB 查询结果",
    "htmlMessage": errorDisplay
  });
}
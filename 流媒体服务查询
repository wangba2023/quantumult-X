// 生成报告函数优化
async function generateReport() {
  let res = "<div style='font-family: -apple-system; padding: 10px;'>";
  res += "<h3 style='text-align: center;'>流媒体解锁报告</h3>";
  
  Object.entries(services).forEach(([name, service]) => {
    res += `<p>${service.emoji} <b>${name}</b>: ${service.status}</p>`;
  });

  res += `<hr/><p>节点信息 ➟ ${$environment.params}</p>`;
  res += "</div>";
  
  $done({
    title: "流媒体状态检测",
    htmlMessage: res,
    ...(services.GeneralError && { alert: true })
  });
}
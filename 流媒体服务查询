/* 辅助函数 */
function getFlag(code) {
  return flags.get(code.toUpperCase()) || "🌐";
}

async function generateReport() {
  let res = "------------------------------";
  for (const [name, service] of Object.entries(services)) {
    res += `</br><b>${service.emoji} ${name}</b>: ${service.status}</br>`;
  }
  res += `------------------------------</br>节点信息 ➟ ${$environment.params}`;
  $done({ title: "流媒体解锁报告", htmlMessage: res });
}

/* HTTP请求统一处理 */
async function fetchAPI(options) {
  try {
    const resp = await $.http.get({ 
      ...options,
      timeout: 5000,
      headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)...' }
    });
    return resp.body;
  } catch (e) {
    return null;
  }
}


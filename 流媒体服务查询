// 修复后的Netflix检测逻辑
async function testNetflix() {
  try {
    const filmIds = [81280792, 80018499];
    for (const id of filmIds) {
      const result = await checkNF(id);
      if (result.status === "Success") {
        services.Netflix.status = result.isFullAccess ? 
          `完整支持${arrow}${getFlag(result.region)} 🎉` : 
          `仅自制剧${arrow}${getFlag(result.region)} ⚠️`;
        services.Netflix.region = result.region;
        break;
      }
    }
  } catch (e) {
    services.Netflix.status = "检测超时 🚦";
    $.logErr(e);
  }
}

// 补充缺失的checkNF实现
async function checkNF(filmId) {
  const options = {
    url: `https://www.netflix.com/title/${filmId}`,
    policy: $environment.params,
    timeout: 5000,
    headers: {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0...)",
      "Accept-Language": "en-US,en;q=0.9"
    }
  };

  try {
    const response = await $.task.fetch(options);
    if (response.statusCode === 404) {
      return { status: "OriginalOnly" };
    } else if (response.statusCode === 403) {
      return { status: "NotAvailable" };
    } else if (response.statusCode === 200) {
      const region = parseRegion(response.headers);
      return {
        status: "Success",
        region: region,
        isFullAccess: filmId === 81280792
      };
    }
    return { status: "Unknown" };
  } catch (error) {
    return { status: "Timeout" };
  }
}

// 添加地区解析函数
function parseRegion(headers) {
  try {
    const url = headers["X-Originating-URL"];
    return url.split("/")[3].split("-")[0].toUpperCase();
  } catch (e) {
    return "UNKNOWN";
  }
}

// 统一错误处理

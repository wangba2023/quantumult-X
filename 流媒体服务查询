async function testYouTube() {
  try {
    const options = {
      url: CONFIG.YOUTUBE.URL,
      headers: {
        "User-Agent": CONFIG.YOUTUBE.USER_AGENT,
        "Accept-Language": "en-US,en;q=0.9"
      },
      timeout: CONFIG.TIMEOUT,
      opts: { policy: $environment.params }
    };

    const response = await $.http.get(options);
    if (!response || response.statusCode !== 200) {
      ytb = "检测失败";
      return;
    }

    const region = detectYouTubeRegion(response.body);
    ytb = region ? `🎉支持 ${arrow}${getCountryFlagEmoji(region)}${region}` : "🚫未支持";
  } catch (error) {
    ytb = "检测超时";
    $.logErr("YouTube测试错误:", error);
  }
}

function detectYouTubeRegion(body) {
  const regionMatch = body.match(/"GL":"(.*?)"/);
  if (regionMatch) return regionMatch[1].toUpperCase();
  if (body.includes("www.google.cn")) return "CN";
  return null;
}

async function testNetflix() {
  try {
    const results = await Promise.allSettled([
      testFilm(CONFIG.NETFLIX.MAIN_FILM_ID),
      testFilm(CONFIG.NETFLIX.AREA_TEST_FILM_ID)
    ]);

    const [mainResult, areaResult] = results;
    netflix = mainResult.value || areaResult.value || "🚫未支持";
  } catch (error) {
    netflix = "检测失败";
    $.logErr("Netflix测试错误:", error);
  }
}

async function testFilm(filmId) {
  try {
    const options = {
      url: `${CONFIG.NETFLIX.BASE_URL}${filmId}`,
      headers: { "User-Agent": CONFIG.NETFLIX.USER_AGENT },
      timeout: CONFIG.TIMEOUT,
      opts: { policy: $environment.params }
    };

    const response = await $.http.get(options);
    if (!response) return null;

    switch (response.statusCode) {
      case 200:
        return handleSuccessResponse(response, filmId);
      case 403:
        return "🚫未支持";
      case 404:
        return filmId === CONFIG.NETFLIX.MAIN_FILM_ID ? null : "🟡仅支持自制剧";
      default:
        return null;
    }
  } catch (error) {
    return null;
  }
}

function handleSuccessResponse(response, filmId) {
  const region = response.headers["X-Originating-URL"]?.split("/")[3]?.split("-")[0] || "us";
  const flag = getCountryFlagEmoji(region.toUpperCase());
  return filmId === CONFIG.NETFLIX.MAIN_FILM_ID 
    ? `🎉完整支持${arrow}${flag}${region.toUpperCase()}`
    : `🟡仅支持自制剧${arrow}${flag}${region.toUpperCase()}`;
}

async function testChatGPT() {
  try {
    const [ip, trace] = await Promise.all([getIP(), fetchChatGPTTrace()]);
    
    const cf = parseTrace(trace);
    const { warpStatus, ipType } = analyzeIP(ip, cf);
    const isSupported = CONFIG.CHATGPT.REGIONS.includes(cf.loc);

    gpt = isSupported 
      ? `${ipType} ➟ ${getCountryFlagEmoji(cf.loc)}${cf.loc}`
      : "🚫未解锁";
  } catch (error) {
    gpt = "检测失败";
    $.logErr("ChatGPT测试错误:", error);
  }
}

async function fetchChatGPTTrace() {
  const options = {
    url: CONFIG.CHATGPT.TRACE_URL,
    timeout: CONFIG.TIMEOUT,
    opts: { policy: $environment.params }
  };
  const response = await $.http.get(options);
  return response?.body || "";
}

function analyzeIP(originalIP, cfData) {
  return {
    warpStatus: cfData.warp === "plus" || cfData.warp === "on",
    ipType: cfData.ip === originalIP ? "🎉原生解锁" : "🟡代理解锁"
  };
}

async function testSpotify() {
  try {
    const options = {
      url: CONFIG.SPOTIFY.API_URL,
      headers: {
        "Content-Type": "application/x-www-form-urlencoded",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
      },
      body: CONFIG.SPOTIFY.POST_DATA,
      timeout: 20000,
      opts: { policy: $environment.params }
    };

    const response = await $.http.post(options);
    const result = parseSpotifyResponse(response?.body);
    spotify = result || "🔴未解锁";
  } catch (error) {
    spotify = "检测失败";
    $.logErr("Spotify测试错误:", error);
  }
}

function parseSpotifyResponse(body) {
  try {
    const data = JSON.parse(body);
    if (data.status === 311) {
      return `🎉已解锁 ${arrow}${getCountryFlagEmoji(data.country)}${data.country}`;
    }
    return null;
  } catch {
    return null;
  }
}

function getCountryFlagEmoji(countryCode) {
  const codePoints = (countryCode || "")
    .toUpperCase()
    .split("")
    .map(c => 127397 + c.charCodeAt());
  return String.fromCodePoint(...codePoints);
}

async function getIP() {
  try {
    const options = {
      url: `https://ipinfo.io/json?token=${$.token}`,
      timeout: 5000,
      opts: { policy: $environment.params }
    };
    const response = await $.http.get(options);
    return JSON.parse(response.body)?.ip || "";
  } catch {
    return "";
  }
}


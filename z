// 节点信息查询（IP，服务商，国家，时区，经纬度，货币）
if ($response.statusCode !== 200) $done(null);

// ================= 配置常量 =================
const DEFAULTS = {
  CITY: "高谭市",
  ISP: "Cross-GFW.org",
  FLAGS: {
    COUNTRY: "🏳️",    // 默认国旗
    CURRENCY: "💲"    // 默认货币符号
  }
};

// ================= 工具函数 =================
const getValidValue = (value, defaultValue) => value || defaultValue;
const sanitizeArea = area => area === "中华民国" ? "台湾" : area;

// ================= 数据映射 =================
const FLAGS = new Map([...]); // 保持原有映射数据

// ================= 主逻辑 =================
const { body } = $response;
const data = JSON.parse(body);

// 调试输出关键字段（调试完成后可删除）
console.log(`DEBUG: 
CountryCode: ${data.countryCode}
Currency: ${data.currency}
RegionName: ${data.regionName}`);

// 安全获取标识
const countryFlag = FLAGS.get(data.countryCode) || DEFAULTS.FLAGS.COUNTRY;
const currencyFlag = FLAGS.get(data.currency) || DEFAULTS.FLAGS.CURRENCY;

const title = `${countryFlag}${sanitizeArea(data.country)}❣️${data.timezone}`;
const subtitle = `${data.query}❣️${data.currency}❣️${data.as}`;
const ip = `${data.query}${countryFlag}`;

const description = `
------------------------------

🖥️服务商: ${getValidValue(data.isp, DEFAULTS.ISP)}
🌍地区: ${getValidValue(data.regionName, DEFAULTS.CITY)}
🗺️IP地址: ${data.query}${countryFlag}
🕗时区: ${data.timezone}
📍经纬度: ${data.lon},${data.lat}
🪙货币: ${data.currency}${currencyFlag}`;

$done({ title, subtitle, ip, description });